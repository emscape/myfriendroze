{
  "hosting": {
    "public": "astro/dist/client",
    "predeploy": [
      "npm --prefix astro run build"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/stripe-webhook",
        "function": { "functionId": "stripeWebhook", "region": "us-west1" }
      },
      {
        "source": "/create-checkout-session-fn",
        "function": { "functionId": "createCheckoutSession", "region": "us-west1" }
      },
      {
        "source": "**",
        "function": { "functionId": "ssrAstro", "region": "us-west1" }
      }
    ],
    "headers": [
      {
        "source": "/shop",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/shop/**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/gallery",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/gallery/**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      },
      {
        "source": "/products/**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "firebase/functions",
    "runtime": "nodejs22",
    "codebase": "default",
    "predeploy": [
      "npm --prefix astro run build",
      "npm --prefix firebase/functions run build"
    ]
  },
  "storage": {
    "rules": "firebase/storage.rules"
  }
}
