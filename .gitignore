# Dependencies
node_modules/

# Build output
dist/
.firebase/
.astro/

# Environment variables
.env
.env.local
.env.production
.env.production.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Secrets & service accounts — never commit these.
# Broad on purpose: a near-miss during this repo's first commit showed
# firebase/service-account.json (no "firebase-" prefix, no hyphen) slipping
# past narrower patterns. Match anything containing "service-account" or
# "serviceaccount" (any case, any separator) at any depth.
secrets/
**/*service*account*.json
**/*ServiceAccount*.json

# OS / editor
.DS_Store
Thumbs.db
.idea/

# Working notes (per CLAUDE.md — not user-facing)
docs/

# Legacy reference material, not part of the live site
theme_export__ddsucculents-com-crave__*/

# Misc (carried over from existing file)
.memory-bank
newsletter-subscribers.json

# Real customer PII (import_customers.js's CSV export) — never commit.
# Anchored to this exact path on purpose: a bare "data/" here previously
# matched ANY directory named "data" anywhere in the repo, which silently
# excluded astro/src/data/*.js (products.js, events.js, syncedGallery.js,
# syncedProducts.js) — essential source files, not generated/secret data.
# That gap meant the site's actual product/event data was never committed
# in this repo's first-ever commit, and GitHub Actions CI was failing on
# every push as a result (a fresh clone had no product data to build with)
# without anyone noticing, since local runs still had the files on disk.
firebase/functions/data/
