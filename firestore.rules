rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['myfriendroze@gmail.com', 'myfriendroze.store@gmail.com'];
    }

    match /customers/{customerId} {
      allow read, write: if false; // Cloud Functions (Admin SDK) only
    }

    match /orders/{orderId} {
      allow read, write: if false; // Cloud Functions (Admin SDK) only
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Saved venue addresses (e.g. Jackalope Pasadena, Common Space
    // Brewing) Roze enters once in the admin app and reuses on future
    // events. Internal admin data only — unlike products/events/gallery,
    // the public site never reads this collection, so it doesn't need a
    // public read rule.
    match /savedLocations/{locationId} {
      allow read, write: if isAdmin();
    }
  }
}
