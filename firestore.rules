rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['myfriendroze@gmail.com', 'myfriendroze.store@gmail.com'];
    }

    match /customers/{customerId} {
      allow read, write: if false; // Cloud Functions (Admin SDK) only
    }

    match /orders/{orderId} {
      allow read, write: if false; // Cloud Functions (Admin SDK) only
    }

    match /products/{productId} {
      // Public reads are gated on isActive + publishAt so a scheduled
      // (delayed-publish) product isn't visible to a client reading
      // Firestore directly before its reveal time — isAdmin() still sees
      // everything, since the admin app manages products regardless of
      // publish state. get('publishAt', null) (rather than a plain
      // `'publishAt' in resource.data` check) treats a field that's absent
      // and one that's explicitly null the same way — the admin app writes
      // an explicit null to clear a schedule (same idiom as events' link/
      // clearLink), so both cases must mean "no publish gate".
      //
      // IMPORTANT — this only protects a direct get() by document ID.
      // Firestore rules can't prove a per-document predicate (publishAt)
      // against an unauthenticated *list/collection query* that doesn't
      // itself filter on that field — a public client query such as
      // `.where('isActive', '==', true)` would get PERMISSION_DENIED
      // outright once evaluated against this rule, not a silently
      // isActive-only result. No public (non-admin) client query exists
      // anywhere in this codebase today (the site reads via the Admin SDK,
      // which bypasses rules entirely — see firestore-admin.js), so nothing
      // currently breaks. But if a public collection-query reader is ever
      // added, it must either authenticate as admin or add a matching
      // publishAt filter of its own — it will not work unmodified against
      // this rule. (Caught in review on PR #38.)
      allow read: if isAdmin() || (
        resource.data.isActive == true &&
        (resource.data.get('publishAt', null) == null ||
         resource.data.get('publishAt', null) <= request.time)
      );
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Saved venue addresses (e.g. Jackalope Pasadena, Common Space
    // Brewing) Roze enters once in the admin app and reuses on future
    // events. Internal admin data only — unlike products/events/gallery,
    // the public site never reads this collection, so it doesn't need a
    // public read rule.
    match /savedLocations/{locationId} {
      allow read, write: if isAdmin();
    }
  }
}
